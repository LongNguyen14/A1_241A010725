class MainActivity : AppCompatActivity() {
    private val history = ArrayList<String>()
    private lateinit var historyTextView: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)
        historyTextView = findViewById(R.id.historyTextView)
        savedInstanceState?.let { bundle ->
            val saved = bundle.getStringArrayList("KEY_HISTORY")
            if (saved != null) {
                history.clear()
                history.addAll(saved)
                updateHistoryView()
            }
        }
    }

    private fun logEvent(event: String) {
        history.add(event)
        updateHistoryView()
        Log.d("APP", event)
    }

    private fun updateHistoryView() {
        historyTextView.text = history.joinToString("\n")
    }

    override fun onSaveInstanceState(outState: Bundle) {
        super.onSaveInstanceState(outState)
        outState.putStringArrayList("KEY_HISTORY", ArrayList(history))
    }

    override fun onPause() {
        super.onPause()
        
    }
}

// Câu 2
class MainViewModel : ViewModel() {
    val history = MutableLiveData<MutableList<String>>(mutableListOf())
    fun addEvent(e: String) {
        val list = history.value ?: mutableListOf()
        list.add(e)
        history.value = list
    }
}

class MainActivity : AppCompatActivity() {
    private lateinit var vm: MainViewModel
    private lateinit var historyTextView: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)
        historyTextView = findViewById(R.id.historyTextView)

        vm = ViewModelProvider(this).get(MainViewModel::class.java)
        vm.history.observe(this) { list ->
            historyTextView.text = list.joinToString("\n")
        }
    }

    private fun logEvent(event: String) {
        vm.addEvent(event)
        Log.d("APP", event)
    }
}
